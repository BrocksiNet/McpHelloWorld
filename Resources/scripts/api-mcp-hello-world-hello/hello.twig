{% block response %}
    {# AppMcpToolExecutor POSTs {arguments: {...}} — hook.request is the parsed POST array #}
    {% set args = hook.request.arguments ?? {} %}
    {% set name = args.name ?? 'World' %}

    {% set response = services.response.json({
        success: true,
        data: {
            message: 'Hello, ' ~ name ~ '! Greetings from the McpHelloWorld app.',
            timestamp: 'now'|date('c')
        }
    }) %}

    {% do hook.setResponse(response) %}
{% endblock %}
